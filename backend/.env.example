DATABASE_URL=postgresql://replay:replay@127.0.0.1:5432/replay
PUBLIC_ORIGIN=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=3001

# Server-side order flow. No account/key required in disabled or demo mode.
ORDERFLOW_FEED=disabled
ORDERFLOW_CUSTOMER_ACCESS=false
ORDERFLOW_DATA_RIGHTS_CONFIRMED=false
ORDERFLOW_NQ_CONTRACT=
ORDERFLOW_ES_CONTRACT=
DATABENTO_API_KEY=
# Docker supplies the SDK runtime; local live use needs requirements.txt installed.
# DATABENTO_PYTHON=/absolute/path/to/venv/bin/python

# Authentication: access token 15 minutes; rotating refresh session one calendar month.
# Optional >=32-byte secret. If blank, a stable secret is generated in PostgreSQL.
AUTH_JWT_SECRET=
AUTH_REGISTRATION_ENABLED=false
# Verified Google/GitHub signup is enabled independently of password signup.
AUTH_OAUTH_REGISTRATION_ENABLED=true
# Configure your own email/password before deployment to claim existing local-owner data.
AUTH_OWNER_EMAIL=
AUTH_OWNER_USERNAME=owner
AUTH_BOOTSTRAP_PASSWORD=
# Optional comma-separated allowlist for a private installation.
AUTH_ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

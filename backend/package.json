{
  "name": "@eazy-trading/backend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "node ../node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "import:sqlite": "node dist/scripts/import-sqlite.js",
    "test:integration": "npm run build && node --import tsx --test test/*.e2e.test.ts",
    "prebuild": "npm run build --workspace @eazy-trading/orderflow",
    "predev": "npm run build --workspace @eazy-trading/orderflow"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "@eazy-trading/orderflow": "2.0.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
